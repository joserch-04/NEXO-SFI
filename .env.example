# Copiar a .env y sustituir ambos marcadores con secretos distintos.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_PORT=3306

# Solo para compose.api.yaml: completar con secretos propios y un certificado confiable.
